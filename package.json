{
  "name": "@brainworker/tackback",
  "version": "0.9.2",
  "private": false,
  "description": "Anchored comments for any web page — attach to a block, a text phrase, or a region over images/diagrams and other non-text content; export as JSON or hook into a backend. Headless, zero runtime dependencies, offline.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./panel": {
      "types": "./types/panel/index.d.ts",
      "import": "./src/panel/index.js"
    },
    "./pdf": {
      "types": "./types/pdf/index.d.ts",
      "import": "./src/pdf/index.js"
    },
    "./umd": "./dist/tackback.umd.js",
    "./umd.min": "./dist/tackback.umd.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "types",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "types": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm run types && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "PolyForm-Shield-1.0.0",
  "keywords": [
    "annotations",
    "comments",
    "anchors",
    "pdf",
    "review",
    "feedback",
    "tackback"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainworker-org/tackback.git"
  },
  "homepage": "https://github.com/brainworker-org/tackback#readme",
  "bugs": "https://github.com/brainworker-org/tackback/issues",
  "author": "Brainworker <contact@brainworker.org>",
  "peerDependencies": {
    "pdfjs-dist": "*"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "^5.9.3"
  }
}
